# Contact form (/contact). Copy to .env.local for local work; set the same keys on Railway.
# Without RESEND_API_KEY and CONTACT_FROM_EMAIL the form still renders and shows the email fallback.

# Resend API key with "Sending access" for jattosolutions.com. Never commit a real key.
RESEND_API_KEY=

# Sender address on a domain verified in Resend, e.g. "Jatto Solutions <contact@jattosolutions.com>".
CONTACT_FROM_EMAIL=

# Optional. Where messages go; defaults to the contact email in src/data/site.ts.
CONTACT_TO_EMAIL=

# Optional, local only. Set to "log" to print messages to the server console instead of sending.
# Ignored when NODE_ENV is production.
CONTACT_EMAIL_MODE=
